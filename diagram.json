{
  "version": 1,
  "author": "Adriane Victoria Cardoso Czyczza",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp32",
      "top": 0,
      "left": 20,
      "attrs": {}
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": -105,
      "left": 270,
      "attrs": { "lux": "400" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 105,
      "left": 270,
      "attrs": { "value": "2048" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 35,
      "left": -105,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 58,
      "left": -45,
      "attrs": { "value": "220" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": 120,
      "left": 440,
      "attrs": { "i2cAddress": "0x3c" }
    }
  ],
  "connections": [
    [ "esp32:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp32:RX0", "$serialMonitor:TX", "", [] ],
    [ "esp32:3V3", "ldr1:VCC", "red", [ "h35", "v-75", "h110" ] ],
    [ "esp32:GND.1", "ldr1:GND", "black", [ "h55", "v-55", "h90" ] ],
    [ "esp32:D34", "ldr1:AO", "green", [ "h75", "v-35", "h70" ] ],
    [ "esp32:3V3", "pot1:VCC", "red", [ "h35", "v125", "h110" ] ],
    [ "esp32:GND.1", "pot1:GND", "black", [ "h55", "v100", "h90" ] ],
    [ "esp32:D35", "pot1:SIG", "blue", [ "h75", "v75", "h70" ] ],
    [ "esp32:D2", "led1:A", "orange", [ "h-55", "v-25", "h-35" ] ],
    [ "led1:C", "r1:1", "black", [ "v20", "h25" ] ],
    [ "r1:2", "esp32:GND.2", "black", [ "h35", "v35", "h25" ] ],
    [ "oled1:VCC", "esp32:3V3", "red", [] ],
    [ "oled1:GND", "esp32:GND.2", "black", [] ],
    [ "oled1:SDA", "esp32:D21", "green", [] ],
    [ "oled1:SCL", "esp32:D22", "blue", [] ]
  ],
  "dependencies": {},
  "serialMonitor": {
    "display": "terminal",
    "newline": "crlf",
    "convertEol": true
  }
}
